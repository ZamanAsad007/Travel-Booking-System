# -------------------------------------------------------------
# Global Environment Variables for Travel Booking System
# -------------------------------------------------------------

# JWT Secret for cross-service authentication verification
JWT_SECRET=travel_booking_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Dedicated Databases per Service
AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
BOOKING_DB_NAME=booking_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# Service Ports
AUTH_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
GATEWAY_PORT=8080

# Service-to-Service URLs (Internal Docker Network)
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
BOOKING_SERVICE_URL=http://booking-service:3003

# Message Broker & Cache (Phases 5+)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379

# Email / Mailpit (Phase 7)
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
