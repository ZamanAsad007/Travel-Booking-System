{
  "name": "travel-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Microservices-based travel booking application",
  "type": "module",
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{js,json}\"",
    "format:check": "prettier --check \"**/*.{js,json}\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:e2e": "node tests/e2e/happy-path.js",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "build": "docker compose up --build -d",
    "seed": "docker compose exec catalog-service node src/seeds/seed.js",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "jest": "^30.5.2",
    "prettier": "^3.5.0",
    "supertest": "^7.3.1",
    "zod": "^4.6.5"
  }
}
